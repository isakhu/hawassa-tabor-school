# seed/
# This directory will contain database seed scripts for populating
# the database with initial/demo data for development and testing.
# Planned seed files:
#   seed_users.py        → create default admin account and sample users
#   seed_students.py     → insert sample student records
#   seed_teachers.py     → insert sample teacher records
#   seed_classes.py      → create sample classes and assign teachers
#   seed_grades.py       → generate sample grade entries
#   seed_attendance.py   → generate sample attendance records
#   run_all.py           → master script to run all seeds in correct order
