# EduCore environment variables
# Copy to .env locally and replace every placeholder with a real value.
# NEVER commit the real .env file.

# Database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/school_db

# JWT / Security
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Application
ENVIRONMENT=development
# Set true only when you intentionally want the local/demo dataset.
DEMO_SEED_DATA=false

# Initial administrator (development values only)
ADMIN_EMAIL=yzak
ADMIN_PASSWORD=change-this-password
ADMIN_FULL_NAME=EduCore Administrator

# CORS
ALLOWED_ORIGINS=http://localhost:3000

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Optional PostgreSQL container settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=school_db
